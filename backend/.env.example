# FAKE-SHA backend — copy to `.env` and adjust (optional; dotenv loads automatically)

# Default analyzer when request omits `analyzer`: svm | roberta | xlmr
FAKE_SHA_ANALYZER=xlmr

# XLM-R model source (pick one approach; Hub id wins if both are set):
#   Hub:   FAKE_SHA_XLMR_HUB_ID=your-org/fake-sha-xlmr
#   Local: FAKE_SHA_XLMR_ARTIFACT_DIR=C:\path\to\save_pretrained
# Default local folder: backend/artifacts/xlmr/
# FAKE_SHA_XLMR_HUB_ID=
# FAKE_SHA_XLMR_ARTIFACT_DIR=
# Legacy alias for ARTIFACT_DIR or Hub id (org/name): FAKE_SHA_XLMR_MODEL=

# RoBERTa (same pattern):
# FAKE_SHA_ROBERTA_HUB_ID=
# FAKE_SHA_ROBERTA_ARTIFACT_DIR=

# SVM: local pickles only (not Hugging Face model repos)
# FAKE_SHA_SVM_ARTIFACT_DIR=

# Private Hub repos: set HF_TOKEN or HUGGING_FACE_HUB_TOKEN in the environment

# Softmax temperature for XLM-R confidence and SHAP surrogate model (same value keeps them aligned).
# Higher values soften probabilities and widen displayed confidence (typical: 5–8).
FAKE_SHA_XLMR_TEMPERATURE=6.0

# Post-softmax confidence calibration (xlmr only)
# 0.0 = raw softmax only, 1.0 = fully use margin/entropy target
FAKE_SHA_XLMR_CONF_CAL_STRENGTH=0.9
# Weight of top-2 margin vs entropy certainty (0.0..1.0)
FAKE_SHA_XLMR_CONF_MARGIN_WEIGHT=0.65
# Displayed confidence range after calibration (0–1)
FAKE_SHA_XLMR_CONF_FLOOR=0.52
FAKE_SHA_XLMR_CONF_CAP=0.97

# SHAP explainability (xlmr analyzer)
ENABLE_SHAP=true
SHAP_MAX_WORDS=400
SHAP_TOP_K=20
SHAP_MAX_EVALS=96

# Optional persistence
# SUPABASE_URL=
# SUPABASE_KEY=

# CORS: comma-separated origins, or * for allow-all (disables credential cookies on wildcard).
# FAKE_SHA_CORS_ORIGINS=*

