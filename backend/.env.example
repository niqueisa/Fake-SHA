# FAKE-SHA backend — copy to `.env` and adjust (optional; dotenv loads automatically)

# Default analyzer when request omits `analyzer`: svm | roberta | xlmr
FAKE_SHA_ANALYZER=xlmr

# XLM-R: directory with Hugging Face save_pretrained output (config.json, weights, tokenizer).
# Defaults to backend/artifacts/xlmr if unset.
# FAKE_SHA_XLMR_ARTIFACT_DIR=

# Softmax temperature for XLM-R confidence and SHAP surrogate model (same value keeps them aligned).
FAKE_SHA_XLMR_TEMPERATURE=3.0

# Optional post-softmax confidence calibration (xlmr only)
# 0.0 = raw confidence only, 1.0 = fully calibrated target
FAKE_SHA_XLMR_CONF_CAL_STRENGTH=0.7
# Weight of top-2 margin vs entropy certainty (0.0..1.0)
FAKE_SHA_XLMR_CONF_MARGIN_WEIGHT=0.65

# SHAP explainability (xlmr analyzer)
ENABLE_SHAP=true
SHAP_MAX_WORDS=400
SHAP_TOP_K=20
SHAP_MAX_EVALS=96

# Optional persistence
# SUPABASE_URL=
# SUPABASE_KEY=

# CORS: comma-separated origins, or * for allow-all (disables credential cookies on wildcard).
# FAKE_SHA_CORS_ORIGINS=*

